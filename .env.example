# Copy this file to .env and fill in real values. Never commit the real .env.

# Generate a fresh one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True locally, False in production
DEBUG=True

# Comma-separated. Add your domain here for production, e.g.:
# ALLOWED_HOSTS=yourdomain.in,www.yourdomain.in
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated, must include scheme, needed once DEBUG=False, e.g.:
# CSRF_TRUSTED_ORIGINS=https://yourdomain.in,https://www.yourdomain.in
CSRF_TRUSTED_ORIGINS=

# Leave unset locally to use SQLite. In production (Railway/Neon/etc.), set e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

SITE_NAME=Card Manager
CONTACT_EMAIL=
# Leave blank to disable Google Analytics
GA_MEASUREMENT_ID=
